#!/bin/bash
# Keep Omarchy shell plugins, the bar layout, and config files such as
# keybindings in sync between machines through a private git repo.
#
#   omarchy-sync status [--offline]   JSON summary for the bar widget
#   omarchy-sync push                 make the repo match this machine
#   omarchy-sync pull                 make this machine match the repo
#   omarchy-sync auto                 what the widget runs on its timer
#   omarchy-sync init [repo]          create (or connect) the sync repo
#
# The repo holds plugins.json (id + git URL of every git-managed plugin),
# shell.json, and files/<path> for synced files under ~/.config. Each machine
# decides what it syncs through this widget's settings in its own shell.json,
# which never leave the machine:
#
#   syncPlugins        installed plugins, and which non-bar plugins are enabled
#   syncBar            bar layout, position, and widget settings
#   syncShellSettings  everything else in shell.json (idle, lock, ...)
#   syncKeybindings    ~/.config/hypr/bindings.lua
#   syncInput          ~/.config/hypr/input.lua (mouse, touchpad, keyboard)
#   extraFiles         more paths under ~/.config to sync as whole files
#   syncTheme          the theme, custom themes, and the current wallpaper
#   syncWallpaperLibrary  which Wallpaper Library categories are downloaded
#   localOnly          plugin ids that stay machine-specific
#   removePlugins      let a pull remove plugins the repo no longer lists
#   mode               Manual | Push automatically | Push and pull automatically
#   onConflict         Ask | Keep this machine | Use the repo
#   notify             desktop notifications for automatic syncs
#
# Pushing only replaces the parts this machine syncs, so machines that sync
# different things share one repo without overwriting each other. The commit
# this machine last synced at is the baseline that tells local and remote
# changes apart.
#
# Synced files are never deleted by a sync, only created or replaced. A pull
# backs up every file it replaces, and rolls them all back if Hyprland reports
# new config errors after reloading.
#
# look.json holds the theme name, custom themes (a git URL, or a hash of the
# files copied to themes/<name>/), the wallpaper, and Wallpaper Library
# categories. A Wallpaper Library image that dharmx/walls has is synced by its
# path and downloaded on its own; any other wallpaper is copied to wallpapers/.
# Wallpapers compare by content hash, so where an image lives doesn't matter.
# Like files, themes and categories are only ever added.

set -uo pipefail

export GIT_TERMINAL_PROMPT=0

SELF_ID="io.github.jacueblol.omarchy-sync"
# This plugin was called Plugin Sync before 2.0.
LEGACY_ID="io.github.jacueblol.plugin-sync"
CONFIG_DIR="${OMARCHY_SYNC_CONFIG_DIR:-$HOME/.config}"
PLUGINS_DIR="${OMARCHY_SYNC_PLUGINS_DIR:-$CONFIG_DIR/omarchy/plugins}"
SHELL_JSON="${OMARCHY_SYNC_SHELL_JSON:-$CONFIG_DIR/omarchy/shell.json}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-sync"
REPO_DIR="$STATE_DIR/repo"
BASE_FILE="$STATE_DIR/synced-commit"
URL_FILE="$STATE_DIR/repo-url"
LOG_FILE="$STATE_DIR/last.log"
BACKUP_DIR="$STATE_DIR/backups"
THEMES_DIR="$CONFIG_DIR/omarchy/themes"
SYNCED_WALLPAPERS="$CONFIG_DIR/omarchy/wallpapers/synced"
OMARCHY_CURRENT="${OMARCHY_SYNC_OMARCHY_CURRENT:-$HOME/.local/state/omarchy/current}"
OMARCHY_ROOT="${OMARCHY_PATH:-/usr/share/omarchy}"
WALLPAPER_LIBRARY="$PLUGINS_DIR/io.github.jacueblol.wallpaper-library/wallpaper-library"
HOST="$(cat /etc/hostname 2>/dev/null || uname -n)"

if [[ ! -e $STATE_DIR && -d ${STATE_DIR%/*}/omarchy-plugin-sync ]]; then
  mv "${STATE_DIR%/*}/omarchy-plugin-sync" "$STATE_DIR"
fi
mkdir -p "$STATE_DIR"

die() { echo "omarchy-sync: $*" >&2; exit 1; }

# ---------------------------------------------------------------- settings

shell_json() { if [[ -f $SHELL_JSON ]]; then jq . "$SHELL_JSON" 2>/dev/null || die "shell.json is not valid JSON"; else echo '{}'; fi; }

# This widget's entry in the bar layout, or {}.
widget_settings() {
  shell_json | jq --arg id "$SELF_ID" --arg old "$LEGACY_ID" \
    '[.bar.layout // {} | .[] | arrays | .[] | select(.id == $id or .id == $old)] | sort_by(.id != $id) | first // {}'
}

load_settings() {
  local s
  s=$(widget_settings)
  setting() { jq -r --arg k "$1" --arg d "$2" 'if has($k) and .[$k] != null then .[$k] | tostring else $d end' <<<"$s"; }
  REPO_SETTING="${OMARCHY_SYNC_REPO:-$(setting repo "")}"
  SYNC_PLUGINS=$(setting syncPlugins true)
  SYNC_BAR=$(setting syncBar true)
  SYNC_OTHER=$(setting syncShellSettings false)
  REMOVE_PLUGINS=$(setting removePlugins true)
  MODE=$(setting mode "Push automatically")
  ON_CONFLICT=$(setting onConflict "Ask")
  NOTIFY=$(setting notify true)
  # Comma or space separated; this widget is always machine-specific.
  LOCAL_ONLY=$(setting localOnly "" | tr ', ' '\n\n' | jq -Rn --arg self "$SELF_ID" --arg old "$LEGACY_ID" '[inputs | select(length > 0)] + [$self, $old] | unique')
  CATS=$(jq -nc --argjson p "$SYNC_PLUGINS" --argjson b "$SYNC_BAR" --argjson o "$SYNC_OTHER" '{plugins: $p, bar: $b, other: $o}')
  # Synced files as [{path, label}], paths relative to ~/.config. Anything
  # absolute or climbing out with .. is ignored.
  SYNC_FILES=$(
    {
      [[ $(setting syncKeybindings true) == true ]] && printf '%s\t%s\n' hypr/bindings.lua Keybindings
      [[ $(setting syncInput false) == true ]] && printf '%s\t%s\n' hypr/input.lua "Mouse and keyboard input"
      setting extraFiles "" | tr ', ' '\n\n' | sed -e 's#^~/\.config/##' -e '/^$/d' | while IFS= read -r p; do printf '%s\t%s\n' "$p" "$p"; done
    } | jq -Rnc '[inputs | split("\t") | {path: .[0], label: .[1]}
        | select(.path | (startswith("/") or test("(^|/)\\.\\.(/|$)")) | not)] | unique_by(.path)'
  )
  SYNC_THEME=$(setting syncTheme false)
  # Only while Wallpaper Library is installed; a pull may install it.
  SYNC_LIBRARY_SETTING=$(setting syncWallpaperLibrary false)
  SYNC_LIBRARY=$SYNC_LIBRARY_SETTING
  [[ -x $WALLPAPER_LIBRARY ]] || SYNC_LIBRARY=false
}

synced_paths() { jq -r '.[].path' <<<"$SYNC_FILES"; }

# "owner/name", an https URL, or an ssh URL → a clonable URL.
repo_url() {
  local repo="$REPO_SETTING"
  [[ -z $repo && -f $URL_FILE ]] && repo=$(<"$URL_FILE")
  [[ -z $repo ]] && return 1
  [[ $repo =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] && repo="https://github.com/$repo.git"
  printf '%s' "$repo"
}

notify() {
  [[ $NOTIFY == true ]] || return 0
  command -v notify-send >/dev/null && notify-send -a "Omarchy Sync" "$@" || true
}

# ---------------------------------------------------------------- shell.json parts

# Shared jq definitions. $ids are machine-specific plugin ids, $c the synced
# categories.
JQ_DEFS='
  def is_local($ids): (if type == "object" then .id else . end) as $i | $ids | index($i) != null;
  def strip($ids): map(select(is_local($ids) | not));
  def other_keys: keys - ["bar", "plugins", "disabledPlugins"];
  def strip_layout($ids):
    if (.layout | type) == "object"
    then .layout |= (map_values(if type == "array" then strip($ids) else . end) | with_entries(select(.value != [])))
    else . end;

  # Only the synced parts, minus machine-specific plugins. Used for comparing.
  def project($c; $ids):
    . as $s
    | (if $c.bar then {bar: (($s.bar // {}) | strip_layout($ids))} else {} end)
    + (if $c.plugins then {plugins: (($s.plugins // []) | strip($ids)), disabledPlugins: (($s.disabledPlugins // []) | strip($ids))} else {} end)
    + (if $c.other then ($s | with_entries(select(.key | IN("bar", "plugins", "disabledPlugins") | not))) else {} end);

  # Put entries back at their old index, clamped to the new length.
  def reinsert($old; $ids):
    reduce ($old | to_entries[] | select(.value | is_local($ids))) as $e (.; .[0:$e.key] + [$e.value] + .[$e.key:]);

  # Replace the synced parts of the base (.) with $in, keeping the base'"'"'s
  # machine-specific entries where they were. Parts $in lacks stay as they are.
  def merge($in; $c; $ids):
    . as $base
    | (if $c.bar and ($in | has("bar")) then
        .bar = (($in.bar // {}) | strip_layout($ids))
        | .bar.layout = (
            (.bar.layout // {}) as $new
            | (($base.bar.layout // {}) | keys) + ($new | keys) | unique
            | map(. as $k | {key: $k, value: (($new[$k] // []) | reinsert(($base.bar.layout // {})[$k] // []; $ids))})
            | from_entries
            | with_entries(select(.value != []))
          )
      else . end)
    | (if $c.plugins and ($in | has("plugins")) then
        .plugins = ((($in.plugins // []) | strip($ids)) + (($base.plugins // []) | map(select(is_local($ids)))))
        | .disabledPlugins = ((($in.disabledPlugins // []) | strip($ids)) + (($base.disabledPlugins // []) | map(select(is_local($ids)))))
        | if .disabledPlugins == [] and ($base | has("disabledPlugins") | not) then del(.disabledPlugins) else . end
      else . end)
    | (if $c.other and ($in | other_keys | length > 0) then
        reduce other_keys[] as $k (.; del(.[$k])) | . + ($in | with_entries(select(.key | IN("bar", "plugins", "disabledPlugins") | not)))
      else . end);
'

# jq with the definitions above; the filter is the last argument.
jqs() { jq --argjson c "$CATS" --argjson ids "$LOCAL_ONLY" "${@:1:$#-1}" "$JQ_DEFS ${!#}"; }

# ---------------------------------------------------------------- plugins

# Every git-managed plugin with an origin, as a sorted JSON array.
local_plugins_json() {
  local dir id url
  for dir in "$PLUGINS_DIR"/*/; do
    dir=${dir%/}
    [[ -f $dir/manifest.json && -d $dir/.git && ! -L $dir ]] || continue
    id=$(jq -r '.id // empty' "$dir/manifest.json" 2>/dev/null)
    [[ -n $id ]] || id=${dir##*/}
    url=$(git -C "$dir" remote get-url origin 2>/dev/null) || continue
    jq -nc --arg id "$id" --arg url "$url" '{id: $id, url: $url}'
  done | jq -s 'sort_by(.id)'
}

# Plugins that can't be synced: plain folders, symlinks, or no origin.
unsyncable_json() {
  local dir id
  for dir in "$PLUGINS_DIR"/*/; do
    dir=${dir%/}
    [[ -f $dir/manifest.json ]] || continue
    if [[ -L $dir || ! -d $dir/.git ]] || ! git -C "$dir" remote get-url origin >/dev/null 2>&1; then
      id=$(jq -r '.id // empty' "$dir/manifest.json" 2>/dev/null)
      jq -nc --arg id "${id:-${dir##*/}}" '$id'
    fi
  done | jq -s 'sort'
}

# ---------------------------------------------------------------- files

# {path: git blob id} for every synced file on this machine; null when the
# file doesn't exist here.
local_files_json() {
  local p
  synced_paths | while IFS= read -r p; do
    jq -nc --arg p "$p" --arg h "$([[ -f $CONFIG_DIR/$p ]] && git hash-object "$CONFIG_DIR/$p")" '{key: $p, value: (if $h == "" then null else $h end)}'
  done | jq -sc 'from_entries'
}

# The same for the repo at a commit (or none, for no commit).
repo_files_json() {
  local p
  synced_paths | while IFS= read -r p; do
    jq -nc --arg p "$p" --arg h "$([[ -n $1 ]] && git -C "$REPO_DIR" rev-parse --verify --quiet "$1:files/$p" 2>/dev/null)" '{key: $p, value: (if $h == "" then null else $h end)}'
  done | jq -sc 'from_entries'
}

# Lines a pull would add and remove in each synced file the repo changes,
# as [{path, label, added, removed, created}].
file_pull_plan() {
  local commit="$1" p tmp added removed
  [[ -n $commit ]] || { echo '[]'; return; }
  tmp=$(mktemp)
  synced_paths | while IFS= read -r p; do
    git -C "$REPO_DIR" show "$commit:files/$p" >"$tmp" 2>/dev/null || continue
    if [[ -f $CONFIG_DIR/$p ]]; then
      cmp -s "$tmp" "$CONFIG_DIR/$p" && continue
      read -r added removed _ < <(git diff --no-index --numstat -- "$CONFIG_DIR/$p" "$tmp")
      jq -nc --arg p "$p" --argjson a "${added:-0}" --argjson r "${removed:-0}" '{path: $p, added: $a, removed: $r, created: false}'
    else
      jq -nc --arg p "$p" --argjson a "$(wc -l <"$tmp")" '{path: $p, added: $a, removed: 0, created: true}'
    fi
  done | jq -sc --argjson files "$SYNC_FILES" 'map(. as $f | . + {label: ($files[] | select(.path == $f.path) | .label)})'
  rm -f "$tmp"
}

hypr_running() { [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && command -v hyprctl >/dev/null; }

hypr_errors() { hyprctl configerrors 2>/dev/null | sed '/^[[:space:]]*$/d'; }

# Write the repo's version of every synced file that differs here. Hyprland
# files are checked by reloading Hyprland: if that brings new config errors,
# every file is put back as it was and the pull stops.
apply_files() {
  local p dest blob backup changed=() created=() hypr=false before="" after
  backup="$BACKUP_DIR/$(date +%Y%m%d-%H%M%S)"
  while IFS= read -r p; do
    blob=$(git -C "$REPO_DIR" rev-parse --verify --quiet "HEAD:files/$p" 2>/dev/null) || continue
    dest=$CONFIG_DIR/$p
    if [[ -f $dest ]]; then
      [[ $(git hash-object "$dest") == "$blob" ]] && continue
      mkdir -p "$(dirname "$backup/$p")" && cp -p "$dest" "$backup/$p" || die "could not back up $p; nothing was changed"
    else
      created+=("$p")
    fi
    changed+=("$p")
    [[ $p == hypr/* ]] && hypr=true
  done < <(synced_paths)
  ((${#changed[@]})) || return 0

  [[ $hypr == true ]] && hypr_running && before=$(hypr_errors)
  for p in "${changed[@]}"; do
    dest=$CONFIG_DIR/$p
    mkdir -p "$(dirname "$dest")"
    # Write through the existing file, so symlinks from a dotfiles manager stay.
    git -C "$REPO_DIR" show "HEAD:files/$p" >"$STATE_DIR/incoming" && cat "$STATE_DIR/incoming" >"$dest" || die "could not write $p"
  done
  rm -f "$STATE_DIR/incoming"

  if [[ $hypr == true ]] && hypr_running; then
    hyprctl reload >/dev/null 2>&1
    sleep 0.5
    after=$(hypr_errors)
    if [[ -n $after && $after != "$before" ]]; then
      for p in "${changed[@]}"; do
        if [[ " ${created[*]} " == *" $p "* ]]; then rm -f "$CONFIG_DIR/$p"
        else cat "$backup/$p" >"$CONFIG_DIR/$p"; fi
      done
      hyprctl reload >/dev/null 2>&1
      echo "Hyprland reported errors in the synced files, so they were put back:" >&2
      head -n 5 <<<"$after" >&2
      die "pull stopped; nothing else was changed"
    fi
  fi

  # Keep the 20 most recent backups.
  ls -1d "$BACKUP_DIR"/*/ 2>/dev/null | head -n -20 | xargs -r rm -rf
  echo "Updated ${changed[*]}"
  [[ -d $backup ]] && echo "Replaced files were backed up to $backup"
}

# ---------------------------------------------------------------- theme and wallpaper

# A short hash of every file in a folder (minus .git), for copied themes.
dir_hash() {
  (cd "$1" 2>/dev/null && find -L . -type f -not -path './.git/*' -print0 | sort -z | xargs -0 -r sha256sum) | sha256sum | cut -c1-16
}

file_hash() { [[ -f $1 ]] && sha256sum <"$1" | cut -d' ' -f1; }

# User-installed themes as [{name, url}] for git clones and [{name, hash}] for
# hand-made ones. Symlinks are someone's working copy and empty folders
# aren't themes, so both are skipped.
local_themes_json() {
  local dir name url
  for dir in "$THEMES_DIR"/*/; do
    dir=${dir%/}
    name=${dir##*/}
    [[ ! -L $dir && -n $(find "$dir" -type f -print -quit 2>/dev/null) ]] || continue
    if [[ -d $dir/.git ]] && url=$(git -C "$dir" remote get-url origin 2>/dev/null); then
      jq -nc --arg n "$name" --arg u "$url" '{name: $n, url: $u}'
    else
      jq -nc --arg n "$name" --arg h "$(dir_hash "$dir")" '{name: $n, hash: $h}'
    fi
  done | jq -sc 'sort_by(.name)'
}

current_theme() { cat "$OMARCHY_CURRENT/theme.name" 2>/dev/null; }

current_background() { readlink -f "$OMARCHY_CURRENT/background" 2>/dev/null; }

library_categories() {
  [[ $SYNC_LIBRARY == true ]] || { echo null; return; }
  "$WALLPAPER_LIBRARY" categories 2>/dev/null | jq -Rnc '[inputs | select(length > 0)] | sort'
}

# The parts of the look this machine syncs, in the form fingerprints compare.
local_look_json() {
  local name="" bg="" themes='[]'
  if [[ $SYNC_THEME == true ]]; then
    name=$(current_theme)
    bg=$(file_hash "$(current_background)")
    themes=$(local_themes_json)
  fi
  jq -nc --argjson t "$SYNC_THEME" --argjson l "$SYNC_LIBRARY" --arg name "$name" --arg bg "$bg" \
    --argjson themes "$themes" --argjson cats "$(library_categories)" '
    (if $t then {theme: $name, themes: $themes, background: (if $bg == "" then null else $bg end)} else {} end)
    + (if $l then {categories: $cats} else {} end)'
}

# The same parts of look.json at a commit (or none, for no commit).
repo_look_json() {
  { if [[ -n $1 ]]; then repo_file "$1" look.json '{}'; else echo '{}'; fi; } |
    jq -c --argjson t "$SYNC_THEME" --argjson l "$SYNC_LIBRARY" '
      (if $t then {
        theme: (.theme // ""),
        themes: ((.themes // []) | map(if .url then {name, url} else {name, hash} end) | sort_by(.name)),
        background: (.background.hash // null)
      } else {} end)
      + (if $l then {categories: ((.categories // []) | sort)} else {} end)'
}

# How look.json records the wallpaper at $1: by its path in the Wallpaper
# Library when dharmx/walls has it, by its path in Omarchy for stock theme
# backgrounds, and otherwise as a copy in the repo.
background_entry() {
  local bg="$1" hash="$2" name=${1##*/} lib rel
  if [[ -x $WALLPAPER_LIBRARY ]]; then
    lib=$(readlink -f "$("$WALLPAPER_LIBRARY" path)")
    rel=${bg#"$lib"/}
    if [[ -n $lib && $bg == "$lib"/* && $rel =~ ^[^/]+/[^/]+$ ]] &&
      curl -fsIL --max-time 10 "https://raw.githubusercontent.com/dharmx/walls/HEAD/${rel// /%20}" >/dev/null 2>&1; then
      jq -nc --arg h "$hash" --arg n "$name" --arg r "$rel" '{hash: $h, name: $n, library: $r}'
      return
    fi
  fi
  if [[ $bg == "$OMARCHY_ROOT"/* ]]; then
    jq -nc --arg h "$hash" --arg n "$name" --arg r "${bg#"$OMARCHY_ROOT"/}" '{hash: $h, name: $n, omarchy: $r}'
    return
  fi
  mkdir -p "$REPO_DIR/wallpapers" && cp "$bg" "$REPO_DIR/wallpapers/$name" || return 1
  jq -nc --arg h "$hash" --arg n "$name" '{hash: $h, name: $n, file: ("wallpapers/" + $n)}'
}

# Write this machine's look into the repo checkout, keeping the parts it
# doesn't sync.
push_look() {
  [[ $SYNC_THEME == true || $SYNC_LIBRARY == true ]] || return 0
  local look themes name bg hash entry
  look=$(repo_file HEAD look.json '{}')

  if [[ $SYNC_THEME == true ]]; then
    themes=$(local_themes_json)
    # Hand-made themes are copied; git themes travel as their URL.
    while IFS= read -r name; do
      rm -rf "${REPO_DIR:?}/themes/$name" && mkdir -p "$REPO_DIR/themes" &&
        cp -rL "$THEMES_DIR/$name" "$REPO_DIR/themes/$name" && rm -rf "$REPO_DIR/themes/$name/.git" ||
        die "could not copy theme $name; nothing was pushed"
    done < <(jq -r '.[] | select(.hash) | .name' <<<"$themes")

    bg=$(current_background)
    entry=null
    if [[ -f $bg ]]; then
      hash=$(file_hash "$bg")
      entry=$(jq -c '.background // null' <<<"$look")
      if [[ $(jq -r '.hash // ""' <<<"$entry") != "$hash" ]]; then
        entry=$(background_entry "$bg" "$hash") || die "could not copy the wallpaper; nothing was pushed"
      fi
    fi
    # Only the current wallpaper's copy stays in the repo.
    find "$REPO_DIR/wallpapers" -type f -not -name "$(jq -r '.file // "" | split("/") | last' <<<"$entry")" -delete 2>/dev/null

    look=$(jq -c --arg theme "$(current_theme)" --argjson themes "$themes" --argjson bg "$entry" \
      '.theme = $theme | .themes = $themes | .background = $bg' <<<"$look")
  fi

  if [[ $SYNC_LIBRARY == true ]]; then
    look=$(jq -c --argjson cats "$(library_categories)" '.categories = $cats' <<<"$look")
  fi
  jq -S . <<<"$look" >"$REPO_DIR/look.json"
}

# A local path for the wallpaper look.json describes, downloading or copying
# it if needed.
resolve_background() {
  local entry="$1" name rel lib dest
  name=$(jq -r '.name // "wallpaper"' <<<"$entry")
  name=${name//\//_}
  if rel=$(jq -re '.library // empty' <<<"$entry"); then
    if [[ -x $WALLPAPER_LIBRARY ]]; then
      "$WALLPAPER_LIBRARY" fetch "$rel" 2>>"$LOG_FILE" | tail -n 1
      return
    fi
    dest=$SYNCED_WALLPAPERS/$name
    [[ -f $dest ]] || { mkdir -p "$SYNCED_WALLPAPERS" &&
      curl -fsSL --max-time 120 -o "$dest" "https://raw.githubusercontent.com/dharmx/walls/HEAD/${rel// /%20}"; } || return 1
  elif rel=$(jq -re '.omarchy // empty' <<<"$entry"); then
    dest=$OMARCHY_ROOT/$rel
    [[ -f $dest ]] || return 1
  elif rel=$(jq -re '.file // empty' <<<"$entry"); then
    dest=$SYNCED_WALLPAPERS/$name
    mkdir -p "$SYNCED_WALLPAPERS" && git -C "$REPO_DIR" show "HEAD:$rel" >"$dest" || return 1
  else
    return 1
  fi
  printf '%s\n' "$dest"
}

# Make this machine's look match look.json. Prints what it did; returns 1 if
# anything was skipped.
pull_look() {
  [[ $SYNC_THEME == true || $SYNC_LIBRARY == true ]] || return 0
  local look missing name url hash dest backup entry path ok=0
  look=$(repo_file HEAD look.json '{}')

  if [[ $SYNC_LIBRARY == true ]]; then
    mapfile -t missing < <(comm -23 <(jq -r '.categories // [] | .[]' <<<"$look" | sort -u) <("$WALLPAPER_LIBRARY" categories | sort -u))
    if ((${#missing[@]})); then
      if "$WALLPAPER_LIBRARY" download "${missing[@]}" >>"$LOG_FILE" 2>&1; then
        echo "Downloaded wallpaper categories: ${missing[*]}"
      else
        echo "Skipped wallpaper categories ${missing[*]} (download failed)"; ok=1
      fi
    fi
  fi
  [[ $SYNC_THEME == true ]] || return $ok

  backup="$BACKUP_DIR/$(date +%Y%m%d-%H%M%S)"
  # A non-whitespace separator, so an empty url isn't skipped over.
  while IFS=$'\x1f' read -r name url hash; do
    # The same names omarchy theme install accepts.
    (LC_ALL=C; [[ $name =~ ^[a-z0-9_][a-z0-9._+-]*$ ]]) || continue
    dest=$THEMES_DIR/$name
    if [[ -n $url ]]; then
      [[ -e $dest ]] && continue
      if omarchy-git-url-check "$url" >>"$LOG_FILE" 2>&1 && git clone --quiet -- "$url" "$dest" >>"$LOG_FILE" 2>&1; then
        echo "Installed theme $name"
      else
        echo "Skipped theme $name (install failed)"; ok=1
      fi
    else
      [[ -d $REPO_DIR/themes/$name && ! -L $dest ]] || continue
      [[ -d $dest && $(dir_hash "$dest") == "$hash" ]] && continue
      if [[ -d $dest ]]; then
        mkdir -p "$backup/themes" && mv "$dest" "$backup/themes/$name" || { echo "Skipped theme $name (backup failed)"; ok=1; continue; }
      fi
      mkdir -p "$THEMES_DIR" && cp -r "$REPO_DIR/themes/$name" "$dest" && echo "Updated theme $name"
    fi
  done < <(jq -r '.themes // [] | .[] | [.name, .url // "", .hash // ""] | join("\u001f")' <<<"$look")

  # The theme first: setting it also picks one of its backgrounds.
  name=$(jq -r '.theme // ""' <<<"$look")
  if [[ -n $name && $name != "$(current_theme)" ]]; then
    if omarchy theme set "$name" >>"$LOG_FILE" 2>&1; then echo "Theme set to $name"
    else echo "Skipped theme $name (could not set it)"; ok=1; fi
  fi

  entry=$(jq -c '.background // null' <<<"$look")
  hash=$(jq -r '.hash // ""' <<<"$entry")
  if [[ -n $hash && $hash != "$(file_hash "$(current_background)")" ]]; then
    if path=$(resolve_background "$entry") && [[ -f $path ]] && omarchy theme bg set "$path" >>"$LOG_FILE" 2>&1; then
      echo "Wallpaper set to ${path##*/}"
    else
      echo "Skipped wallpaper $(jq -r '.name' <<<"$entry") (could not get it)"; ok=1
    fi
  fi
  return $ok
}

# ---------------------------------------------------------------- comparing

# Canonical JSON of what this machine syncs, from a plugins list, a
# shell.json, synced file blob ids, and the look. Equal fingerprints mean
# nothing to sync.
fingerprint() {
  local plugins="$1" shell="$2" files="$3" look="$4"
  jqs -nS --argjson p "$plugins" --argjson s "$shell" --argjson f "$files" --argjson l "$look" '{
    plugins: (if $c.plugins then ($p | map(select(is_local($ids) | not)) | map(.id) | sort) else null end),
    shell: ($s | project($c; $ids)),
    files: $f,
    look: $l
  }' | sha256sum | cut -d' ' -f1
}

local_fingerprint() { fingerprint "$(local_plugins_json)" "$(shell_json)" "$(local_files_json)" "$(local_look_json)"; }

# A JSON file from the repo at a commit, or the fallback if missing or broken.
repo_file() {
  local out
  if out=$(git -C "$REPO_DIR" show "$1:$2" 2>/dev/null) && jq -e . >/dev/null 2>&1 <<<"$out"; then
    printf '%s\n' "$out"
  else
    printf '%s\n' "$3"
  fi
}

# A shell.json worth writing: a non-empty JSON object.
valid_shell() { jq -e 'type == "object" and length > 0' >/dev/null 2>&1 <<<"$1"; }

commit_fingerprint() {
  [[ -n $1 ]] || { echo none; return; }
  fingerprint "$(repo_file "$1" plugins.json '[]')" "$(repo_file "$1" shell.json '{}')" "$(repo_files_json "$1")" "$(repo_look_json "$1")"
}

# ---------------------------------------------------------------- repo

ensure_repo() {
  local url
  url=$(repo_url) || die "no sync repo configured; run: omarchy-sync init"
  if [[ ! -d $REPO_DIR/.git ]]; then
    rm -rf "$REPO_DIR"
    git clone --quiet "$url" "$REPO_DIR" 2>/dev/null || die "cannot clone $url"
  elif [[ $(git -C "$REPO_DIR" remote get-url origin) != "$url" ]]; then
    git -C "$REPO_DIR" remote set-url origin "$url"
    rm -f "$BASE_FILE"
  fi
  printf '%s' "$url" >"$URL_FILE"
}

fetch() { timeout 20 git -C "$REPO_DIR" fetch --quiet origin 2>/dev/null; }

branch() { git -C "$REPO_DIR" symbolic-ref --short HEAD 2>/dev/null || echo main; }

remote_head() { git -C "$REPO_DIR" rev-parse --verify --quiet "origin/$(branch)" 2>/dev/null || true; }

base_commit() { [[ -f $BASE_FILE ]] && cat "$BASE_FILE" || true; }

# local | remote | both | new | none — which side changed since the last
# sync. "new" is a machine that has never synced with an existing repo.
classify() {
  local local_fp="$1" remote="$2" base="$3" remote_fp base_fp
  [[ -n $remote ]] || { echo local; return; }
  remote_fp=$(commit_fingerprint "$remote")
  [[ $local_fp == "$remote_fp" ]] && { echo none; return; }
  [[ -n $base ]] || { echo new; return; }
  base_fp=$(commit_fingerprint "$base")
  if [[ $remote_fp == "$base_fp" ]]; then echo local
  elif [[ $local_fp == "$base_fp" ]]; then echo remote
  else echo both
  fi
}

# ---------------------------------------------------------------- commands

cmd_status() {
  local offline="${1:-}" url remote state fetched=true have shell
  load_settings
  have=$(local_plugins_json)
  local settings
  settings=$(jq -n --argjson c "$CATS" --argjson ids "$LOCAL_ONLY" --arg mode "$MODE" --arg conflict "$ON_CONFLICT" \
    --argjson remove "$REMOVE_PLUGINS" '$c + {localOnly: $ids, mode: $mode, onConflict: $conflict, removePlugins: $remove}')

  if ! url=$(repo_url); then
    jq -n --argjson unsync "$(unsyncable_json)" --argjson plugins "$have" --argjson settings "$settings" --argjson files "$SYNC_FILES" \
      '{configured: false, state: "unconfigured", settings: $settings, plugins: ($plugins | map(. + {status: "local"})),
        files: ($files | map(. + {status: "local"})), unsyncable: $unsync}'
    return
  fi
  if ! (ensure_repo) 2>/dev/null; then
    jq -n --arg url "$url" --argjson settings "$settings" \
      '{configured: true, repo: $url, state: "error", error: "Cannot reach the sync repo", settings: $settings, plugins: [], files: [], unsyncable: []}'
    return
  fi
  if [[ $offline != --offline ]]; then fetch || fetched=false; fi

  local files base look
  shell=$(shell_json)
  files=$(local_files_json)
  look=$(local_look_json)
  remote=$(remote_head)
  base=$(base_commit)
  state=$(classify "$(fingerprint "$have" "$shell" "$files" "$look")" "$remote" "$base")

  local remote_plugins='[]' remote_shell='{}' last_host="" last_time=""
  if [[ -n $remote ]]; then
    remote_plugins=$(repo_file "$remote" plugins.json '[]')
    remote_shell=$(repo_file "$remote" shell.json '{}')
    last_host=$(git -C "$REPO_DIR" log -1 --format=%s "$remote" | sed -n 's/^sync from //p')
    last_time=$(git -C "$REPO_DIR" log -1 --format=%cI "$remote")
  fi

  jqs -n \
    --arg url "$url" --arg state "$state" --arg host "$HOST" \
    --arg lastHost "$last_host" --arg lastTime "$last_time" \
    --argjson fetched "$fetched" --argjson hasRemote "$([[ -n $remote ]] && echo true || echo false)" \
    --argjson local "$have" --argjson remote "$remote_plugins" \
    --argjson shell "$shell" --argjson remoteShell "$remote_shell" \
    --argjson unsync "$(unsyncable_json)" --argjson settings "$settings" \
    --argjson syncFiles "$SYNC_FILES" --argjson localFiles "$files" \
    --argjson remoteFiles "$(repo_files_json "$remote")" --argjson baseFiles "$(repo_files_json "$base")" \
    --argjson filePlan "$(file_pull_plan "$remote")" \
    --argjson localLook "$look" --argjson remoteLook "$(repo_look_json "$remote")" --argjson baseLook "$(repo_look_json "$base")" \
    --argjson repoLook "$(if [[ -n $remote ]]; then repo_file "$remote" look.json '{}'; else echo '{}'; fi)" '
    ($local | map(.id)) as $l | ($remote | map(.id)) as $r |
    def look_status($keys):
      ($localLook | with_entries(select(.key | IN($keys[])))) as $mine
      | ($remoteLook | with_entries(select(.key | IN($keys[])))) as $theirs
      | ($baseLook | with_entries(select(.key | IN($keys[])))) as $was
      | if $mine == $theirs then "synced"
        elif ($hasRemote | not) or $theirs == $was then "local"
        elif $mine == $was then "remote"
        else "both" end;
    (($shell | project($c; $ids)) as $mine | ($remoteShell | project($c; $ids)) as $theirs | {
      bar: ($c.bar and $hasRemote and $mine.bar != $theirs.bar),
      plugins: ($c.plugins and $hasRemote and ($mine.plugins != $theirs.plugins or $mine.disabledPlugins != $theirs.disabledPlugins)),
      other: ($c.other and $hasRemote and ($mine | del(.bar, .plugins, .disabledPlugins)) != ($theirs | del(.bar, .plugins, .disabledPlugins)))
    }) as $differs |
    {
      configured: true, repo: $url, state: $state, host: $host, fetched: $fetched,
      lastHost: $lastHost, lastTime: $lastTime, settings: $settings,
      differs: $differs, unsyncable: $unsync,
      plugins: (
        [ $local[] | . + {status: (
            if is_local($ids) then "machine"
            elif ($c.plugins | not) then "off"
            elif (.id | IN($r[])) then "synced"
            else "local" end)} ] +
        [ $remote[] | select((.id | IN($l[])) | not) | select(is_local($ids) | not) | . + {status: (if $c.plugins then "remote" else "off" end)} ]
        | sort_by(.id)),
      # synced | local (changed here) | remote (changed elsewhere) | both
      files: [ $syncFiles[] | .path as $p | . + {status: (
          if $localFiles[$p] == $remoteFiles[$p] then "synced"
          elif $remoteFiles[$p] == null or $remoteFiles[$p] == $baseFiles[$p] then "local"
          elif $localFiles[$p] == $baseFiles[$p] then "remote"
          else "both" end)} ]
        + (if $localLook | has("theme") then [{path: "", label: "Theme and wallpaper", status: look_status(["theme", "themes", "background"])}] else [] end)
        + (if $localLook | has("categories") then [{path: "", label: "Wallpaper Library categories", status: look_status(["categories"])}] else [] end),
      # What a pull would do here.
      pullPlan: {
        install: (if $c.plugins then [$remote[] | select(is_local($ids) | not) | .id | select(IN($l[]) | not)] else [] end),
        remove: (if $c.plugins and $settings.removePlugins then [$local[] | select(is_local($ids) | not) | .id | select(IN($r[]) | not)] else [] end),
        bar: $differs.bar, pluginStates: $differs.plugins, other: $differs.other,
        files: $filePlan,
        look: (if $hasRemote then {
          theme: (if ($localLook | has("theme")) and ($repoLook.theme // "") != "" and $repoLook.theme != $localLook.theme then $repoLook.theme else null end),
          themes: (if $localLook | has("themes") then [($repoLook.themes // [])[] | . as $t
            | select(($localLook.themes | map(select(.name == $t.name and (if $t.url then true else .hash == $t.hash end))) | length) == 0) | .name] else [] end),
          wallpaper: (if ($localLook | has("background")) and ($repoLook.background.hash // null) != null and $repoLook.background.hash != $localLook.background then $repoLook.background.name else null end),
          categories: (if $localLook | has("categories") then (($repoLook.categories // []) - ($localLook.categories // [])) else [] end)
        } else {theme: null, themes: [], wallpaper: null, categories: []} end)
      }
    }'
}

with_lock() {
  exec 9>"$STATE_DIR/lock"
  flock -n 9 || die "another sync is already running"
}

cmd_push() {
  with_lock
  load_settings
  ensure_repo
  fetch || die "cannot fetch from the sync repo"
  local remote have shell
  remote=$(remote_head)
  [[ -n $remote ]] && git -C "$REPO_DIR" reset --quiet --hard "$remote"
  have=$(local_plugins_json)
  shell=$(shell_json)

  # Replace only what this machine syncs; keep the rest of the repo as is.
  local repo_plugins='[]' repo_shell='{}'
  [[ -n $remote ]] && repo_plugins=$(repo_file HEAD plugins.json '[]') && repo_shell=$(repo_file HEAD shell.json '{}')
  if [[ $SYNC_PLUGINS == true ]]; then
    jqs -n --argjson repo "$repo_plugins" --argjson mine "$have" \
      '($repo | map(select(is_local($ids)))) + ($mine | map(select(is_local($ids) | not))) | unique_by(.id)' >"$REPO_DIR/plugins.json"
  else
    printf '%s\n' "$repo_plugins" >"$REPO_DIR/plugins.json"
  fi
  local merged
  # Empty is fine here: a machine may sync nothing from shell.json.
  merged=$(jqs -S --argjson mine "$shell" 'merge($mine; $c; $ids)' <<<"$repo_shell") && jq -e 'type == "object"' >/dev/null <<<"$merged" \
    || die "could not merge shell.json; nothing was pushed"
  printf '%s\n' "$merged" >"$REPO_DIR/shell.json"

  # Synced files this machine has replace the repo's; files it lacks stay.
  local p
  while IFS= read -r p; do
    [[ -f $CONFIG_DIR/$p ]] || continue
    mkdir -p "$(dirname "$REPO_DIR/files/$p")" && cp "$CONFIG_DIR/$p" "$REPO_DIR/files/$p" || die "could not copy $p; nothing was pushed"
  done < <(synced_paths)

  push_look

  git -C "$REPO_DIR" add -A .
  if ! git -C "$REPO_DIR" diff --cached --quiet; then
    git -C "$REPO_DIR" -c user.name="Omarchy Sync" -c user.email="omarchy-sync@$HOST" commit --quiet -m "sync from $HOST" || die "commit failed"
    git -C "$REPO_DIR" push --quiet origin "HEAD:$(branch)" 2>/dev/null || die "push failed"
    echo "Pushed this machine's changes"
  else
    echo "Repo already matches this machine"
  fi
  git -C "$REPO_DIR" rev-parse HEAD >"$BASE_FILE"
}

cmd_pull() {
  with_lock
  load_settings
  ensure_repo
  fetch || die "cannot fetch from the sync repo"
  local remote
  remote=$(remote_head)
  [[ -n $remote ]] || die "the sync repo is empty; push from a machine first"
  git -C "$REPO_DIR" reset --quiet --hard "$remote"

  # Files first: if Hyprland rejects them, the pull stops before any plugin
  # is installed or removed.
  apply_files

  local wanted have id url added=0 removed=0 skipped=()
  wanted=$(repo_file HEAD plugins.json '[]')
  have=$(local_plugins_json)

  if [[ $SYNC_PLUGINS == true ]]; then
    # Install plugins the repo has and this machine doesn't.
    while IFS=$'\t' read -r id url; do
      [[ -n $id && ! -e $PLUGINS_DIR/$id ]] || continue
      echo "Installing $id"
      if omarchy plugin add "$url" --yes >>"$LOG_FILE" 2>&1; then
        added=$((added + 1))
      else
        skipped+=("$id (install failed)")
      fi
    done < <(jqs -r --argjson have "$have" '($have | map(.id)) as $h | .[] | select(is_local($ids) | not) | select((.id | IN($h[])) | not) | [.id, .url] | @tsv' <<<"$wanted")

    # Remove git-managed plugins the repo dropped, unless they have local work.
    if [[ $REMOVE_PLUGINS == true ]]; then
      while read -r id; do
        [[ -n $id ]] || continue
        if [[ -n $(git -C "$PLUGINS_DIR/$id" status --porcelain 2>/dev/null) ]]; then
          skipped+=("$id (has local changes, kept)")
          continue
        fi
        echo "Removing $id"
        if omarchy plugin remove "$id" --yes >>"$LOG_FILE" 2>&1; then
          removed=$((removed + 1))
        else
          skipped+=("$id (remove failed)")
        fi
      done < <(jqs -r --argjson wanted "$wanted" '($wanted | map(.id)) as $w | .[] | select(is_local($ids) | not) | .id | select(IN($w[]) | not)' <<<"$have")
    fi
  fi

  # shell.json last, so every widget it names is installed. Read it again:
  # removing a plugin also drops it from the bar.
  local current merged
  current=$(shell_json)
  merged=$(jqs --argjson theirs "$(repo_file HEAD shell.json '{}')" 'merge($theirs; $c; $ids)' <<<"$current") && valid_shell "$merged" \
    || die "could not merge the synced shell.json; this machine's shell.json was left unchanged"
  if [[ $(jq -S . <<<"$current") != "$(jq -S . <<<"$merged")" ]]; then
    [[ -f $SHELL_JSON ]] && cp "$SHELL_JSON" "$SHELL_JSON.bak.$(date +%s)"
    printf '%s\n' "$merged" >"$SHELL_JSON.tmp" && mv "$SHELL_JSON.tmp" "$SHELL_JSON"
    echo "Applied synced shell settings (backup saved next to shell.json)"
  fi

  # The look last: a pull may just have installed Wallpaper Library.
  [[ $SYNC_LIBRARY_SETTING == true && -x $WALLPAPER_LIBRARY ]] && SYNC_LIBRARY=true
  pull_look || skipped+=("parts of the theme or wallpaper (see above)")

  omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
  omarchy-shell shell reloadConfig >/dev/null 2>&1 || true
  # Let Omaplug pick up the new plugin list.
  omarchy-shell omaplug refresh >/dev/null 2>&1 || true

  git -C "$REPO_DIR" rev-parse HEAD >"$BASE_FILE"
  echo "Pulled: $added installed, $removed removed"
  for id in "${skipped[@]}"; do echo "Skipped $id"; done
  ((${#skipped[@]} == 0))
}

# What the widget runs on its timer. Never changes this machine's config
# unless the mode or conflict setting says so.
cmd_auto() {
  local remote state out action=""
  load_settings
  [[ $MODE == Manual ]] && { echo "Manual mode"; return; }
  ensure_repo
  fetch || exit 0
  remote=$(remote_head)
  state=$(classify "$(local_fingerprint)" "$remote" "$(base_commit)")
  case $state in
    local) action=push ;;
    remote) [[ $MODE == "Push and pull automatically" ]] && action=pull ;;
    both)
      case $ON_CONFLICT in
        "Keep this machine") action=push ;;
        "Use the repo") [[ $MODE == "Push and pull automatically" ]] && action=pull ;;
      esac ;;
  esac

  case $action in
    push) cmd_push ;;
    pull)
      if out=$(cmd_pull 2>&1); then notify "Omarchy synced" "$out"
      else notify -u critical "Omarchy Sync needs attention" "$out"; fi
      echo "$out" ;;
    *)
      case $state in
        remote) echo "Changes from another machine are ready to pull" ;;
        both) echo "Both machines changed; choose push or pull" ;;
        new) echo "First sync on this machine; choose push or pull" ;;
        *) echo "In sync" ;;
      esac ;;
  esac
}

cmd_init() {
  local repo="${1:-}"
  load_settings
  [[ -n $repo ]] || repo="$REPO_SETTING"
  if [[ -z $repo ]]; then
    local owner
    owner=$(gh api user --jq .login 2>/dev/null) || die "set the widget's Sync repo setting, or log in with: gh auth login"
    repo="$owner/omarchy-sync"
  fi
  if [[ $repo =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] && command -v gh >/dev/null && ! gh repo view "$repo" >/dev/null 2>&1; then
    read -r -p "Create a private GitHub repo $repo? [y/N] " answer
    [[ $answer == [yY]* ]] || die "cancelled"
    gh repo create "$repo" --private --description "Omarchy plugins, bar layout, and config, synced by Omarchy Sync" >/dev/null || die "could not create $repo"
  fi
  REPO_SETTING="$repo"
  rm -rf "$REPO_DIR" "$BASE_FILE"
  ensure_repo
  # Remember the repo in the widget settings on this machine.
  if [[ $(widget_settings) != "{}" ]]; then
    omarchy bar set "$SELF_ID" repo "$repo" >/dev/null 2>&1 || true
  fi
  if [[ -n $(remote_head) ]]; then
    echo "Connected to $repo, which already has a sync. Open the panel and pull to apply it here."
  else
    git -C "$REPO_DIR" checkout --quiet -B main
    cmd_push
  fi
}

case "${1:-status}" in
  status) cmd_status "${2:-}" ;;
  push) cmd_push ;;
  pull) cmd_pull ;;
  auto) cmd_auto ;;
  init) cmd_init "${2:-}" ;;
  *) die "usage: omarchy-sync status|push|pull|auto|init [repo]" ;;
esac
